{
  "expo": {
    "name": "PyQdeck",
    "slug": "pyqdeck",
    "version": "1.0.3",
    "orientation": "default",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f5f6f2",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.hasanraiyan.pyqdeck",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "itms-apps"
        ]
      }
    },
    "android": {
      "package": "app.hasanraiyan.pyqdeck",
      "versionCode": 53,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#faf7f4",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "autoVerify": true,
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "pyqdeck.in",
              "pathPattern": "/syllabus"
            },
            {
              "scheme": "https",
              "host": "www.pyqdeck.in",
              "pathPattern": "/syllabus"
            },
            {
              "scheme": "https",
              "host": "pyqdeck.in",
              "pathPattern": "/syllabus/.*"
            },
            {
              "scheme": "https",
              "host": "www.pyqdeck.in",
              "pathPattern": "/syllabus/.*"
            },
            {
              "scheme": "https",
              "host": "pyqdeck.in",
              "pathPattern": "/search"
            },
            {
              "scheme": "https",
              "host": "www.pyqdeck.in",
              "pathPattern": "/search"
            },
            {
              "scheme": "https",
              "host": "pyqdeck.in",
              "pathPattern": "/search/.*"
            },
            {
              "scheme": "https",
              "host": "www.pyqdeck.in",
              "pathPattern": "/search/.*"
            },
            {
              "scheme": "https",
              "host": "pyqdeck.in",
              "pathPattern": "/.*/.*/.*/.*"
            },
            {
              "scheme": "https",
              "host": "www.pyqdeck.in",
              "pathPattern": "/.*/.*/.*/.*"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/app-icon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6179737775385101~1811732500",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "expo-font",
      "expo-notifications",
      "./plugins/withVolumeScroll",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-dontwarn kotlin.MustUseReturnValues\n-dontwarn kotlin.**ReturnValue**\n# Clerk: keep full SDK under R8 until clerk-android#941 is confirmed fixed for auth-only apps\n-keep class com.clerk.api.** { *; }\n-keep class com.clerk.ui.** { *; }\n# react-native-device-info reads InstallReferrerClient.newBuilder reflectively (its documented rule)\n-keep class com.android.installreferrer.api.** { *; }"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "pyqdeck-expo",
          "organization": "pyqdeck"
        }
      ],
      "@sentry/react-native",
      [
        "@clerk/expo",
        {
          "theme": "./clerk-theme.json"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "b2dafabf-f248-4e73-a563-41cb2068367e"
      },
      "clerkPublishableKey": "pk_live_Y2xlcmsucHlxZGVjay5pbiQ"
    },
    "owner": "hasanraiyan"
  }
}
